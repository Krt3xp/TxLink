[Unit]
Description=TaxLink Collector - Coleta e sincronizacao de NFS-e
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=taxlink
Group=taxlink
WorkingDirectory=/opt/taxlink-collector
EnvironmentFile=/etc/taxlink/taxlink-collector.env
Environment=TAXLINK_NFSE_CONFIG=/etc/taxlink/config.toml
ExecStart=/opt/taxlink-collector/.venv/bin/taxlink-nfse --config /etc/taxlink/config.toml serve
Restart=on-failure
RestartSec=10
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/taxlink /var/log/taxlink /opt/taxlink-collector/data /opt/taxlink-collector/logs

[Install]
WantedBy=multi-user.target
